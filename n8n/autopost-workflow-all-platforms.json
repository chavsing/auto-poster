    {
      "id": "summarize",
      "name": "Summarize per row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2740,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Collapse the per-platform outcomes back down to one item per sheet row.\nconst byRow = new Map();\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (r.row_number === undefined || r.row_number === null) continue;\n  const key = Number(r.row_number);\n  if (!byRow.has(key)) byRow.set(key, []);\n  byRow.get(key).push(r);\n}\n\nconst ORDER = ['facebook', 'instagram', 'twitter', 'linkedin', 'youtube'];\n\nreturn [...byRow.entries()].map(([row_number, results]) => {\n  results.sort((a, b) => ORDER.indexOf(a.platform) - ORDER.indexOf(b.platform));\n\n  const failed = results.filter((r) => r.state === 'failed').length;\n  const pending = results.filter((r) => r.state === 'submitted').length;\n\n  let status;\n  if (failed === results.length) status = 'failed';\n  else if (failed > 0) status = 'partial';\n  else if (pending > 0) status = 'submitted';\n  else status = 'posted';\n\n  return {\n    json: {\n      row_number,\n      status,\n      result: results\n        .map((r) => `${r.platform}: ${r.state}${r.detail ? ' — ' + r.detail : ''}`)\n        .join(' | '),\n      processedAt: new Date().toISOString(),\n    },\n  };\n});"
      }
    },
    {
      "id": "invalid-result",
      "name": "Invalid result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        100,
        660
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Rows this backend can never publish — write the reason back so they stop\n// being picked up on every sweep.\nreturn $input.all().map((item) => ({\n  json: {\n    row_number: item.json.row_number,\n    status: 'failed',\n    result: 'Skipped — ' + item.json.problems,\n    processedAt: new Date().toISOString(),\n  },\n}));"
      }
    },
