    {
      "id": "blotato-status",
      "name": "Blotato check status",
      "type": "@blotato/n8n-nodes-blotato.blotato",
      "typeVersion": 2,
      "position": [
        2100,
        260
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "post",
        "operation": "get",
        "postSubmissionId": "={{ $json.postSubmissionId }}"
      },
      "notes": "Returns { status: 'in-progress' | 'published' | 'failed', publicUrl, errorMessage }."
    },
    {
      "id": "resolve-outcome",
      "name": "Resolve outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2320,
        260
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turn Blotato's status into the state that lands in the sheet.\n// Runs per item so the matching submission comes back through pairedItem.\nconst stamp = $('Collect submissions').item.json;\nconst st = $json;\n\nlet state;\nlet detail;\n\nif (st.status === 'published') {\n  state = 'posted';\n  detail = st.publicUrl || 'published';\n} else if (st.status === 'failed') {\n  state = 'failed';\n  detail = st.errorMessage || 'publish failed';\n} else if (st.error) {\n  state = 'submitted';\n  detail = 'status check failed (' + String(st.error) + '), submission ' + stamp.postSubmissionId;\n} else {\n  state = 'submitted';\n  detail = 'still in progress, submission ' + stamp.postSubmissionId;\n}\n\nreturn { json: { row_number: stamp.row_number, platform: stamp.platform, state, detail } };"
      }
    },
