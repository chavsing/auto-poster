    {
      "id": "prepare",
      "name": "Prepare jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -780,
        500
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Normalise one sheet row into a publish job.\n// Column headers are matched case-insensitively, so renaming one in the sheet\n// doesn't break this.\nconst PRIVACY = ['public', 'unlisted', 'private'];\n\n// Canonical platform ids. Used for BOTH layouts: a TRUE/FALSE column per\n// platform (what this sheet uses) and a single comma-separated column.\nconst PLATFORM_ALIASES = {\n  facebook: 'facebook', fb: 'facebook', 'facebook page': 'facebook',\n  instagram: 'instagram', ig: 'instagram', insta: 'instagram',\n  twitter: 'twitter', x: 'twitter', 'x / twitter': 'twitter', 'twitter / x': 'twitter',\n  linkedin: 'linkedin', li: 'linkedin',\n  youtube: 'youtube', yt: 'youtube', shorts: 'youtube',\n};\n\nfunction pick(row, names) {\n  for (const name of names) {\n    const key = Object.keys(row).find((k) => k.trim().toLowerCase() === name);\n    if (key && row[key] !== '' && row[key] !== null && row[key] !== undefined) return row[key];\n  }\n  return '';\n}\n\n// A ticked checkbox arrives as a real boolean; a typed one as text.\nfunction truthy(v) {\n  if (v === true) return true;\n  const s = String(v).trim().toLowerCase();\n  return s === 'true' || s === 'yes' || s === 'y' || s === '1' || s === 'x';\n}\n\nfunction platformsFrom(row) {\n  const found = new Set();\n  // (a) one TRUE column per platform\n  for (const key of Object.keys(row)) {\n    const canon = PLATFORM_ALIASES[key.trim().toLowerCase()];\n    if (canon && truthy(row[key])) found.add(canon);\n  }\n  // (b) or a single comma-separated column, if the sheet ever grows one\n  String(pick(row, ['platforms', 'channels', 'accounts', 'social']))\n    .split(/[,;|]/)\n    .map((s) => s.trim().toLowerCase())\n    .filter(Boolean)\n    .forEach((s) => { const c = PLATFORM_ALIASES[s]; if (c) found.add(c); });\n  return [...found];\n}\n\n// Google Sheets can hand back a schedule three different ways depending on how\n// the cell was formatted, so accept all of them rather than trust one.\nfunction parseWhen(v) {\n  if (v === '' || v === null || v === undefined) return null;\n  if (v instanceof Date) return v;\n  if (typeof v === 'number') {\n    // Sheets serial date: days since 1899-12-30, in the spreadsheet's timezone\n    return new Date(Math.round((v - 25569) * 86400000));\n  }\n  const d = new Date(String(v).trim());\n  return isNaN(d.getTime()) ? null : d;\n}\n\nfunction readCommon(row) {\n  const driveUrl = String(pick(row, ['gdrive url', 'drive url', 'google drive url', 'gdrive', 'url', 'link', 'media']));\n  let fileId = String(pick(row, ['file id', 'fileid', 'drive file id', 'gdrive id']));\n  if (!fileId) {\n    const m = driveUrl.match(/\\/d\\/([a-zA-Z0-9_-]{10,})/) || driveUrl.match(/[?&]id=([a-zA-Z0-9_-]{10,})/);\n    fileId = m ? m[1] : '';\n  }\n\n  // Blotato's Media > Upload fetches this URL itself, so it has to be public.\n  // If an image ever fails, try https://lh3.googleusercontent.com/d/<fileId>.\n  const mediaUrl = fileId ? `https://drive.google.com/uc?export=download&id=${fileId}` : '';\n\n  // n8n owns this column. Anything in it means a previous run already claimed\n  // or finished the row — never touch it again, or an approved row would be\n  // re-published on every single sweep.\n  const alreadyHandled = String(pick(row, ['post status', 'automation status', 'publish status'])).trim() !== '';\n\n  // Blank publish time means \"go on the next sweep\"; unreadable is an error,\n  // not a licence to publish immediately.\n  const scheduledRaw = pick(row, ['post at', 'publish at', 'schedule', 'scheduled', 'scheduled at', 'post date', 'publish date']);\n  const hasSchedule = scheduledRaw !== '' && scheduledRaw !== null && scheduledRaw !== undefined;\n  const dueAt = hasSchedule ? parseWhen(scheduledRaw) : null;\n  const badSchedule = hasSchedule && !dueAt;\n  const isDue = !hasSchedule || (!!dueAt && dueAt.getTime() <= Date.now());\n\n  return {\n    driveUrl,\n    fileId,\n    mediaUrl,\n    caption: String(pick(row, ['caption', 'text', 'post caption', 'message', 'content'])),\n    platforms: platformsFrom(row),\n    alreadyHandled,\n    dueAt,\n    badSchedule,\n    isDue,\n  };\n}\n\nreturn $input.all().map((item, i) => {\n  const row = item.json;\n  const c = readCommon(row);\n\n  const privacyRaw = String(pick(row, ['youtube privacy', 'yt privacy', 'visibility', 'privacy'])).toLowerCase();\n\n  const problems = [];\n  if (!c.fileId) problems.push('no Google Drive file id');\n  if (!c.caption) problems.push('empty caption');\n  if (!c.platforms.length) problems.push('no platforms ticked');\n  if (c.badSchedule) problems.push('unreadable publish time');\n\n  return {\n    json: {\n      row_number: row.row_number,\n      driveUrl: c.driveUrl,\n      fileId: c.fileId,\n      caption: c.caption,\n      platforms: c.platforms,\n      mediaUrl: c.mediaUrl,\n      ytTitle: String(pick(row, ['youtube title', 'yt title', 'video title', 'title'])),\n      ytPrivacy: PRIVACY.includes(privacyRaw) ? privacyRaw : 'private',\n      scheduledAt: c.dueAt ? c.dueAt.toISOString() : '',\n      alreadyHandled: c.alreadyHandled,\n      isDue: c.isDue,\n      valid: problems.length === 0,\n      problems: problems.join('; '),\n    },\n    pairedItem: { item: i },\n  };\n});"
      }
    },
