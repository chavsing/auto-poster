    {
      "id": "blotato-media",
      "name": "Blotato upload media",
      "type": "@blotato/n8n-nodes-blotato.blotato",
      "typeVersion": 2,
      "position": [
        320,
        360
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "media",
        "operation": "upload",
        "useBinaryData": false,
        "mediaUrl": "={{ $('Prepare jobs').item.json.mediaUrl }}"
      },
      "notes": "Uploaded once per row and reused by every platform. URL upload, not binary — the node's own note says binary is size-capped and to use a URL for Google Drive files (up to ~60 MB)."
    },
    {
      "id": "fanout",
      "name": "Fan out per platform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        360
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One row in -> one item per selected platform out.\n// Anything that can't be published is routed to 'unsupported' with a reason\n// rather than being attempted and failing with a vague API error.\nconst VIDEO_EXT = /\\.(mp4|mov|m4v|webm|mkv|avi)(\\?|$)/i;\n\n// Same limits the form warns about.\nconst LIMITS = { facebook: 63206, instagram: 2200, twitter: 280, linkedin: 3000, youtube: 5000 };\n\nconst jobs = $('Prepare jobs').all().filter((j) => j.json.valid);\nconst out = [];\n\n$input.all().forEach((item, i) => {\n  const job = jobs[i] ? jobs[i].json : {};\n  const res = item.json || {};\n\n  // Blotato re-hosts the file keeping its real extension, so the URL it returns\n  // tells us whether this is a video.\n  const uploadedUrl = res.url ? String(res.url) : '';\n  // The Blotato node reports failures as a plain string on `error`.\n  const uploadError = res.error\n    ? String(res.error.message || res.error)\n    : (uploadedUrl ? '' : 'Blotato returned no media URL — check the Drive file is shared \"anyone with the link\"');\n  const isVideo = VIDEO_EXT.test(uploadedUrl);\n\n  for (const platform of job.platforms || []) {\n    let reason = '';\n    if (!uploadedUrl) {\n      reason = 'media upload failed: ' + uploadError;\n    } else if (platform === 'youtube' && !isVideo) {\n      reason = 'YouTube accepts video files only';\n    } else if (job.caption.length > LIMITS[platform]) {\n      reason = `caption is ${job.caption.length} characters, ${platform} allows ${LIMITS[platform]}`;\n    }\n\n    out.push({\n      json: {\n        ...job,\n        platform,\n        route: reason ? 'unsupported' : platform,\n        unsupportedReason: reason,\n        mediaUrl: uploadedUrl,\n        isVideo,\n      },\n      pairedItem: { item: i },\n    });\n  }\n});\n\nreturn out;"
      }
    },
