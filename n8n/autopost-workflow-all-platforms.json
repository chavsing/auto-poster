      "notes": "One Blotato account id per platform — or clear the expression on a publish node and pick the account from its dropdown instead.\nfacebookVideoMode: 'reel' | 'video'\ninstagramVideoMode: 'reel' | 'story'\nBoth are ignored for image posts.\nTo post LinkedIn as a Company Page, add 'Linkedin Page' in the LinkedIn publish node's Options."
    },
    {
      "id": "sheet-read",
      "name": "Get new rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -1000,
        500
      ],
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1BDhyws9fM__wv7ygjkEepmB_psVh7QOoFk_x3ZsR48k"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "gid=0",
          "cachedResultName": "Sheet1"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "status",
              "lookupValue": "Publish"
            }
          ]
        },
        "options": {}
