{
  "name": "AutoPost v2 — publish to all platforms via Blotato",
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "nodes": [
    {
      "id": "trigger-schedule",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1440,
        420
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1220,
        500
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-fb-a",
              "name": "facebookAccountId",
              "value": "PASTE_BLOTATO_FACEBOOK_ACCOUNT_ID",
              "type": "string"
            },
            {
              "id": "cfg-fb-p",
              "name": "facebookPageId",
              "value": "PASTE_FACEBOOK_PAGE_ID",
              "type": "string"
            },
            {
              "id": "cfg-fb-m",
              "name": "facebookVideoMode",
              "value": "reel",
              "type": "string"
            },
            {
              "id": "cfg-ig-a",
              "name": "instagramAccountId",
              "value": "PASTE_BLOTATO_INSTAGRAM_ACCOUNT_ID",
              "type": "string"
            },
            {
              "id": "cfg-ig-m",
              "name": "instagramVideoMode",
              "value": "reel",
              "type": "string"
            },
            {
              "id": "cfg-tw-a",
              "name": "twitterAccountId",
              "value": "PASTE_BLOTATO_TWITTER_ACCOUNT_ID",
              "type": "string"
            },
            {
              "id": "cfg-li-a",
              "name": "linkedinAccountId",
              "value": "PASTE_BLOTATO_LINKEDIN_ACCOUNT_ID",
              "type": "string"
            },
            {
              "id": "cfg-yt-a",
