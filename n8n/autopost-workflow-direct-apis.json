    {
      "id": "merge",
      "name": "Collect results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1480, 280],
      "parameters": {
        "mode": "append",
        "numberInputs": 6
      }
    },
    {
      "id": "summarize",
      "name": "Summarize per row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1700, 280],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Collapse the per-platform results back down to one item per sheet row.\nconst byRow = new Map();\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (r.row_number === undefined || r.row_number === null) continue;\n  const key = Number(r.row_number);\n  if (!byRow.has(key)) byRow.set(key, []);\n  byRow.get(key).push(r);\n}\n\nreturn [...byRow.entries()].map(([row_number, results]) => {\n  const failed = results.filter((r) => !r.ok);\n  const status = failed.length === 0\n    ? 'posted'\n    : failed.length === results.length ? 'failed' : 'partial';\n\n  return {\n    json: {\n      row_number,\n      status,\n      result: results\n        .map((r) => `${r.platform}: ${r.ok ? 'ok' : 'FAILED'}${r.detail ? ' — ' + r.detail : ''}`)\n        .join(' | '),\n      processedAt: new Date().toISOString(),\n    },\n  };\n});"
      }
    },
    {
      "id": "invalid-result",
      "name": "Invalid result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-220, 620],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Rows that can never be published — write the reason back so they stop\n// being picked up on every sweep.\nreturn $input.all().map((item) => ({\n  json: {\n    row_number: item.json.row_number,\n    status: 'failed',\n    result: 'Skipped — ' + item.json.problems,\n    processedAt: new Date().toISOString(),\n  },\n}));"
      }
    },
