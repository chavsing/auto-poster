    {
      "id": "prepare",
      "name": "Prepare jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-660, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Normalise one sheet row into a job the rest of the workflow can trust.\n// Header names are matched case-insensitively against the same aliases\n// AppsScript.gs uses, so renaming a column in the sheet doesn't break this.\nconst PLATFORM_ALIASES = {\n  facebook: 'facebook', fb: 'facebook', 'facebook page': 'facebook',\n  instagram: 'instagram', ig: 'instagram', insta: 'instagram',\n  twitter: 'twitter', x: 'twitter', 'x / twitter': 'twitter', 'twitter / x': 'twitter',\n  linkedin: 'linkedin', li: 'linkedin',\n  youtube: 'youtube', yt: 'youtube', shorts: 'youtube',\n};\nconst KNOWN = ['facebook', 'instagram', 'twitter', 'linkedin', 'youtube'];\n\nfunction pick(row, names) {\n  for (const name of names) {\n    const key = Object.keys(row).find((k) => k.trim().toLowerCase() === name);\n    if (key && row[key] !== '' && row[key] !== null && row[key] !== undefined) return row[key];\n  }\n  return '';\n}\n\nreturn $input.all().map((item, i) => {\n  const row = item.json;\n\n  const driveUrl = String(pick(row, ['gdrive url', 'drive url', 'google drive url', 'gdrive', 'url', 'link', 'media']));\n  let fileId = String(pick(row, ['file id', 'fileid', 'drive file id', 'gdrive id']));\n  if (!fileId) {\n    const m = driveUrl.match(/\\/d\\/([a-zA-Z0-9_-]{10,})/) || driveUrl.match(/[?&]id=([a-zA-Z0-9_-]{10,})/);\n    fileId = m ? m[1] : '';\n  }\n\n  const caption = String(pick(row, ['caption', 'text', 'post caption', 'message', 'content']));\n\n  const platforms = [...new Set(\n    String(pick(row, ['platforms', 'channels', 'accounts', 'social']))\n      .split(/[,;|]/)\n      .map((s) => s.trim().toLowerCase())\n      .filter(Boolean)\n      .map((s) => PLATFORM_ALIASES[s] || s)\n      .filter((p) => KNOWN.includes(p))\n  )];\n\n  const problems = [];\n  if (!fileId) problems.push('no Google Drive file id');\n  if (!caption) problems.push('empty caption');\n  if (!platforms.length) problems.push('no recognised platforms');\n\n  return {\n    json: {\n      row_number: row.row_number,\n      driveUrl,\n      fileId,\n      caption,\n      platforms,\n      ytTitle: String(pick(row, ['youtube title', 'yt title', 'video title', 'title'])),\n      ytPrivacy: String(pick(row, ['youtube privacy', 'yt privacy', 'visibility', 'privacy'])) || 'private',\n      valid: problems.length === 0,\n      problems: problems.join('; '),\n    },\n    pairedItem: { item: i },\n  };\n});"
      }
    },
