                "conditions": [
                  {
                    "id": "r-yt",
                    "leftValue": "={{ $json.route }}",
                    "rightValue": "youtube",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "youtube"
            },
            {
