    {
      "id": "fanout",
      "name": "Fan out per platform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 280],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One row in -> one item per selected platform out, each carrying the\n// downloaded media as binary. Combinations the connected nodes genuinely\n// cannot publish are routed to 'unsupported' rather than silently posting\n// something the user didn't ask for.\nconst jobs = $('Prepare jobs').all().filter((i) => i.json.valid);\nconst out = [];\n\n$input.all().forEach((item, i) => {\n  const job = jobs[i] ? jobs[i].json : {};\n  const bin = (item.binary && item.binary.data) || {};\n  const mimeType = bin.mimeType || '';\n  const isVideo = mimeType.startsWith('video/');\n  const isImage = mimeType.startsWith('image/');\n\n  // Instagram fetches media over the public internet — it never sees our binary.\n  const publicUrl = isImage\n    ? `https://lh3.googleusercontent.com/d/${job.fileId}`\n    : `https://drive.google.com/uc?export=download&id=${job.fileId}`;\n\n  for (const platform of job.platforms || []) {\n    let unsupportedReason = '';\n    if (platform === 'youtube' && !isVideo) {\n      unsupportedReason = 'YouTube accepts video files only';\n    }\n    if (platform === 'linkedin' && isVideo) {\n      unsupportedReason = 'the LinkedIn node uploads images only — video needs the LinkedIn video upload API';\n    }\n    if (!isVideo && !isImage) {\n      unsupportedReason = `unsupported media type \"${mimeType || 'unknown'}\"`;\n    }\n\n    out.push({\n      json: {\n        ...job,\n        platform,\n        route: unsupportedReason ? 'unsupported' : platform,\n        unsupportedReason,\n        mimeType,\n        isVideo,\n        isImage,\n        publicUrl,\n        fileName: bin.fileName || 'media',\n      },\n      binary: item.binary,\n      pairedItem: { item: i },\n    });\n  }\n});\n\nreturn out;"
      }
    },
